rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Keep this list in sync with AUTHORIZED_UIDS in
    // src/data/authorizedEditors.ts — that file is a client-side
    // convenience check only, this rule is the real enforcement.
    function isAuthorizedEditor() {
      return request.auth != null && request.auth.uid in [
        // "uid-for-BackendsMan",
        // "uid-for-yolofolo130-ship-it",
      ];
    }

    match /accolades/{accoladeId} {
      allow read: if true;
      allow write: if isAuthorizedEditor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
